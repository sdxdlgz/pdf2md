# Copy this file to `.env.local` (in the same folder) and fill in the values.
#
# Mineru API token (Authorization: Bearer <token>)
MINERU_API_TOKEN=
#
# Vercel Blob read-write token.
# - On Vercel: usually created/managed under Project → Storage → Blob.
# - Locally: create/copy a token from Vercel and put it here.
BLOB_READ_WRITE_TOKEN=

